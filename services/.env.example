# ============================================================
# Shared by every service. In production each service gets only
# the keys it actually needs; this single file is a dev convenience.
# ============================================================

ENVIRONMENT=development

# --- Auth: identical to backend/.env AUTH_JWT_SECRET and frontend AUTH_SECRET ---
AUTH_JWT_SECRET=
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_ISSUER=gradportal-web
AUTH_JWT_AUDIENCE=gradportal-api

# --- Service-to-service auth ---
# Shared bearer for internal endpoints that no browser should ever reach.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_SERVICE_TOKEN=

# --- Database (one Postgres, one schema per service) ---
DATABASE_URL=postgresql+psycopg://gradportal:gradportal@localhost:5437/gradportal

# --- Service discovery ---
CORE_API_URL=http://localhost:8000
DOC_SERVICE_URL=http://localhost:8001
RAG_SERVICE_URL=http://localhost:8002
EVAL_SERVICE_URL=http://localhost:8003
VOICE_SERVICE_URL=http://localhost:8004
FRONTEND_ORIGIN=http://localhost:3000

# --- Embeddings ---
# Served through OpenRouter on the same key as chat. OpenRouter exposes
# POST /api/v1/embeddings even though no embedding model is listed in its
# /models catalogue.
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# Optional: set this to bill embeddings to OpenAI directly instead. The
# "openai/" prefix is stripped automatically when it is set.
OPENAI_API_KEY=

# --- OpenRouter: all chat and reasoning ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Fast path — chat answers
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
# Reasoning path — the "Reason" toggle and document evaluation
OPENROUTER_REASONING_MODEL=openai/o4-mini
OPENROUTER_APP_NAME=GradPortal
OPENROUTER_SITE_URL=http://localhost:3000

# --- ElevenLabs: speech in and out ---
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v1
ELEVENLABS_TTS_MODEL=eleven_turbo_v2_5
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- Upload limits ---
MAX_UPLOAD_BYTES=15728640
DOCUMENT_STORAGE_DIR=./.storage
