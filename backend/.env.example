# ---- Core ----
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:3000

# ---- Database ----
DATABASE_URL=postgresql+psycopg://gradportal:gradportal@localhost:5437/gradportal

# ---- Redis (worker queue + agent scheduling) ----
REDIS_URL=redis://localhost:6379/0

# ---- Auth ----
# MUST match AUTH_SECRET in frontend/.env.local. Auth.js signs the JWT, FastAPI verifies it.
AUTH_JWT_SECRET=change-me-to-a-long-random-string
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_ISSUER=gradportal-web
AUTH_JWT_AUDIENCE=gradportal-api

# Fernet key used to encrypt stored OAuth refresh tokens at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ---- Google (Gmail send-as-user) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Microsoft (Outlook send-as-user, optional) ----
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# ---- Platform notification email (SMTP; mailpit in dev) ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
NOTIFICATION_FROM_EMAIL=notifications@gradportal.local
NOTIFICATION_FROM_NAME=GradPortal

# ---- Admin-uploaded site media ----
MEDIA_STORAGE_DIR=./.media
MAX_MEDIA_UPLOAD_BYTES=26214400

# ---- Ingestion agent ----
AGENT_USER_AGENT=GradPortalBot/0.1 (+https://gradportal.local/bot; contact@gradportal.local)
AGENT_REQUEST_TIMEOUT=20
AGENT_MAX_CONCURRENCY=5
AGENT_RESPECT_ROBOTS=true

# Gated sources. Leave blank to keep the adapter disabled.
LINKEDIN_PARTNER_ACCESS_TOKEN=
HANDSHAKE_API_TOKEN=
HANDSHAKE_INSTITUTION_ID=
